#!/usr/bin/env python3
"""Bandeau d'actions en bas de l'écran, montré quand une app de ACTIONS a le focus.

Surface layer-shell sans clavier : un toucher ou un clic ne vole pas le focus,
et le raccourci part vers l'app avec wtype. Charte : DESIGN.md, action-bar-button.
"""
import json
import subprocess
import threading

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

# app_id sway -> (libellé, touche envoyée avec Ctrl). Une app de plus = une entrée.
# En anglais, comme l'interface de PT35-OS et de Mousepad.
EDIT = [("COPY", "c"), ("CUT", "x"), ("PASTE", "v"),
        ("UNDO", "z"), ("FIND", "f"), ("SAVE", "s")]
ACTIONS = {"mousepad": EDIT, "org.xfce.mousepad": EDIT}

CSS = b"""
window { background: #0b0f0d; border-top: 1px solid #24382e; }
button {
  background: #121a16; background-image: none; box-shadow: none; text-shadow: none;
  color: #63e6a4; border: 1px solid #63e6a4; border-radius: 0;
  font-family: "JetBrains Mono"; font-size: 12px; letter-spacing: 1px;
  min-height: 48px; padding: 0 2px;
}
button:active { background: #e6fff2; color: #06110b; border-color: #e6fff2; }
"""


def ctrl(key):
    subprocess.Popen(["wtype", "-M", "ctrl", "-k", key, "-m", "ctrl"])


def focused_app():
    tree = json.loads(subprocess.run(["swaymsg", "-t", "get_tree"],
                                     capture_output=True, text=True).stdout or "{}")
    stack = [tree]
    while stack:
        node = stack.pop()
        if node.get("focused"):
            props = node.get("window_properties") or {}
            return node.get("app_id") or props.get("class")
        stack += node.get("nodes", []) + node.get("floating_nodes", [])
    return None


class Bar(Gtk.Window):
    def __init__(self):
        super().__init__()
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "pt35-actions")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        for edge in (GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.auto_exclusive_zone_enable(self)
        self.box = Gtk.Box(spacing=8, homogeneous=True, margin=8)
        self.add(self.box)
        self.app = None

    def show_for(self, app):
        if app == self.app:
            return
        self.app = app
        for child in self.box.get_children():
            child.destroy()
        if app not in ACTIONS:
            self.hide()
            return
        for label, key in ACTIONS[app]:
            button = Gtk.Button(label=label, can_focus=False)
            button.connect("clicked", lambda _b, k=key: ctrl(k))
            self.box.add(button)
        self.show_all()


def watch(bar):
    sub = subprocess.Popen(["swaymsg", "-m", "-t", "subscribe", '["window","workspace"]'],
                           stdout=subprocess.PIPE, text=True)
    GLib.idle_add(bar.show_for, focused_app())
    for line in sub.stdout:
        if json.loads(line).get("change") in ("focus", "close", "new", "move"):
            GLib.idle_add(bar.show_for, focused_app())
    GLib.idle_add(Gtk.main_quit)  # sway parti : la boucle de sway/config relance


def main():
    style = Gtk.CssProvider()
    style.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    bar = Bar()
    threading.Thread(target=watch, args=(bar,), daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    main()
